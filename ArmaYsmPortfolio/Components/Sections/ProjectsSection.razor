@using ArmaYsmPortfolio.Services
@inject PortfolioData Data

<section id="projects" class="py-24 bg-black/30 border-y border-white/5 relative">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-end justify-between gap-6 flex-wrap mb-16">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 glass rounded-full mb-4 border border-blue-500/20">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-blue-400 mono">$ ls ./builds/</span>
                </div>
                <h2 class="text-4xl md:text-5xl font-bold tracking-tighter">
                    <span class="gradient-text-purple-blue">Active Builds</span>
                </h2>
                <p class="text-gray-500 mt-2 max-w-2xl mono text-sm">
                    <span class="text-green-400">//</span> Production-ready systems. No placeholder energy.
                </p>
            </div>
            <span class="text-[10px] uppercase tracking-[0.3em] font-bold text-gray-600 mono">
                @Data.Projects.Count records found
            </span>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var p in Data.Projects)
            {
                <article data-tilt data-project-card data-screenshots='@System.Text.Json.JsonSerializer.Serialize(p.Screenshots)' class="group glass p-6 rounded-2xl border border-white/[0.06] hover:border-purple-500/20 transition-all duration-500 relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-purple-500/[0.02] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                    <div class="relative z-10">
                        <div class="flex items-center justify-between mb-4 card-links">
                            <span class="status-badge @p.Badge.ToLowerInvariant() mono">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                                @p.Badge
                            </span>
                            <div class="flex gap-3 text-gray-500">
                                @if (!string.IsNullOrWhiteSpace(p.GitHubUrl))
                                {
                                    <a href="@p.GitHubUrl" target="_blank" class="hover:text-white transition-colors" aria-label="GitHub">
                                        <i class="fab fa-github text-lg"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.DemoUrl))
                                {
                                    <a href="@p.DemoUrl" target="_blank" class="hover:text-white transition-colors" aria-label="Demo">
                                        <i class="fas fa-arrow-up-right-from-square"></i>
                                    </a>
                                }
                            </div>
                        </div>

                        <h3 class="text-lg font-bold group-hover:text-purple-300 transition-colors">@p.Title</h3>
                        <p class="text-gray-500 text-sm mt-0.5 mono text-xs">@p.Subtitle</p>

                        <p class="text-gray-400 text-sm mt-4 leading-relaxed">@p.Description</p>

                        <div class="flex flex-wrap gap-2 mt-5 pt-4 border-t border-white/[0.04]">
                            @foreach (var t in p.Tech)
                            {
                                <span class="tech-tag text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-md bg-white/[0.03] text-gray-500 mono">
                                    @t
                                </span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
