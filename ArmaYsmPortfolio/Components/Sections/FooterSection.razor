<footer id="contact" class="py-24 border-t border-white/5 bg-[#050508] relative overflow-hidden">
    <div class="particle-field"></div>
    <div class="max-w-7xl mx-auto px-6 text-center relative z-10">
        <div class="max-w-2xl mx-auto mb-16">
            <div class="inline-flex items-center gap-2 px-3 py-1 glass rounded-full mb-6 border border-purple-500/20">
                <span class="text-[10px] font-bold uppercase tracking-widest text-purple-400 mono">$ contact --init</span>
            </div>

            <h2 class="text-4xl md:text-6xl font-bold mb-6 tracking-tighter">
                Let's build<br />
                <span class="gradient-text-purple-blue">something legendary</span>
            </h2>

            <p class="text-gray-500 mono text-sm mb-10">
                <span class="text-green-400">PS&gt;</span> Initiate deploy sequence to start a conversation
            </p>

            <form id="contact-form" class="max-w-lg mx-auto text-left">
                <div class="space-y-4 mb-6">
                    <div>
                        <label for="name" class="mono text-xs text-gray-500 uppercase tracking-widest block mb-2">Name</label>
                        <input type="text" id="name" name="name" required
                            class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-white text-sm mono
                            focus:outline-none focus:border-purple-500/40 focus:bg-white/[0.05] transition-all
                            placeholder:text-gray-600" placeholder="Your name" />
                    </div>
                    <div>
                        <label for="email" class="mono text-xs text-gray-500 uppercase tracking-widest block mb-2">Email</label>
                        <input type="email" id="email" name="email" required
                            class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-white text-sm mono
                            focus:outline-none focus:border-purple-500/40 focus:bg-white/[0.05] transition-all
                            placeholder:text-gray-600" placeholder="your@email.com" />
                    </div>
                    <div>
                        <label for="message" class="mono text-xs text-gray-500 uppercase tracking-widest block mb-2">Message</label>
                        <textarea id="message" name="message" rows="4" required
                            class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-white text-sm mono
                            focus:outline-none focus:border-purple-500/40 focus:bg-white/[0.05] transition-all
                            placeholder:text-gray-600 resize-none" placeholder="Tell me about your project..."></textarea>
                    </div>
                </div>

                <button type="submit" id="form-submit"
                    class="w-full bg-purple-600 hover:bg-purple-500 text-white text-sm font-bold px-6 py-3.5 rounded-xl
                    transition-all shadow-lg shadow-purple-900/20 mono flex items-center justify-center gap-2
                    disabled:opacity-50 disabled:cursor-not-allowed">
                    <span class="submit-text">$ Send Message</span>
                    <span class="submit-spinner hidden">
                        <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                        </svg>
                    </span>
                    <span class="submit-done hidden">
                        <i class="fas fa-check"></i> Sent
                    </span>
                </button>
                <p id="form-status" class="mono text-xs mt-3 text-center hidden"></p>
            </form>

            <div class="flex flex-wrap justify-center gap-4 mt-10">
                <a href="https://github.com/Raziel1991" target="_blank" class="group inline-flex items-center gap-3 px-6 py-3 glass-hover rounded-xl border border-white/10 hover:border-purple-500/30 transition-all">
                    <i class="fab fa-github text-lg text-gray-400 group-hover:text-white transition-colors"></i>
                    <span class="mono text-sm text-gray-400 group-hover:text-white transition-colors">GitHub</span>
                </a>
                <a href="https://www.linkedin.com/in/alfonso-raziel-mendoza-avila-6aaa6992/" target="_blank" class="group inline-flex items-center gap-3 px-6 py-3 glass-hover rounded-xl border border-white/10 hover:border-blue-500/30 transition-all">
                    <i class="fab fa-linkedin text-lg text-gray-400 group-hover:text-blue-400 transition-colors"></i>
                    <span class="mono text-sm text-gray-400 group-hover:text-white transition-colors">LinkedIn</span>
                </a>
                <a href="mailto:razielmendozaa@gmail.com" class="group inline-flex items-center gap-3 px-6 py-3 bg-purple-600/10 hover:bg-purple-600/20 rounded-xl border border-purple-500/20 hover:border-purple-500/40 transition-all">
                    <i class="fas fa-envelope text-lg text-purple-400"></i>
                    <span class="mono text-sm text-purple-400">razielmendozaa@gmail.com</span>
                </a>
            </div>
        </div>

        <div class="section-divider mb-12"></div>

        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-gradient-to-tr from-purple-600 to-blue-400 rounded-lg flex items-center justify-center font-bold text-white text-xs">
                    <i class="fas fa-terminal"></i>
                </div>
                <span class="font-bold text-sm tracking-tighter mono">
                    Arma<span class="text-blue-400">Ysm</span>
                </span>
            </div>
            <p class="text-gray-600 text-[10px] uppercase tracking-[0.3em] font-bold mono">
                &copy; @DateTime.Now.Year &bull; Built with Blazor &bull; Powered by Caffeine
            </p>
        </div>
    </div>
</footer>
