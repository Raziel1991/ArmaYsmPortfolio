@page "/Error"
@using System.Diagnostics

<div class="min-h-screen flex items-center justify-center bg-[#08080c]">
    <div class="text-center max-w-lg px-6">
        <h1 class="text-3xl font-bold mb-4 mono">
            <span class="text-red-400">Fatal Error:</span> Unhandled Exception
        </h1>
        <div class="glass p-6 rounded-2xl mb-8 mono text-sm">
            <p class="text-gray-500 mb-2">// The application encountered an unexpected condition</p>
            @if (ShowRequestId)
            {
                <p class="text-gray-400 mb-2">
                    <span class="text-cyan-400">Error ID:</span> <code class="text-amber-400">@RequestId</code>
                </p>
            }
            <p class="text-gray-500 mt-4 text-xs">
                <span class="text-green-400">PS&gt;</span> Try refreshing the page or return home
            </p>
        </div>
        <a href="/" class="inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-500 text-white text-sm font-bold px-6 py-3 rounded-xl transition-all shadow-lg shadow-purple-900/20 mono">
            <span>$</span> cd ~/home
        </a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
